{
  "type": "function",
  "name": "apply_local_trip_changes",
  "description": "向客户端申请原子保存本地行程。只有用户选定或要求定稿后调用。系统 ID 和时间由客户端生成。必须等待 applied 回执才能宣称已保存。缺字段不能写。",
  "parameters": {
    "type": "object",
    "properties": {
      "operationId": {
        "type": "string"
      },
      "tripId": {
        "type": [
          "string",
          "null"
        ]
      },
      "expectedVersion": {
        "type": "integer",
        "minimum": 0
      },
      "sidecars": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "hotel_stay",
                "quote",
                "ticket",
                "warnings"
              ]
            },
            "data": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "ref",
            "kind",
            "data"
          ],
          "additionalProperties": false
        }
      },
      "changes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 50,
        "items": {
          "type": "object",
          "properties": {
            "table": {
              "type": "string",
              "enum": [
                "trips",
                "flights",
                "hotels",
                "transports",
                "pois"
              ]
            },
            "action": {
              "type": "string",
              "enum": [
                "insert",
                "update",
                "delete"
              ]
            },
            "ref": {
              "type": "string"
            },
            "recordId": {
              "type": "string"
            },
            "data": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "table",
            "action",
            "ref"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "operationId",
      "tripId",
      "expectedVersion",
      "changes"
    ],
    "additionalProperties": false
  }
}
