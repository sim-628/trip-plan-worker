{
  "type": "function",
  "name": "restaurantAgent",
  "description": "查询餐厅、咖啡馆、小吃，返回结构化餐饮候选。 将符合该子 Agent 输入约定的完整 JSON 放入 request，必须带 today 和 tripId。",
  "parameters": {
    "type": "object",
    "properties": {
      "request": {
        "type": "object",
        "properties": {
          "today": {
            "type": "string",
            "description": "YYYY-MM-DD 当前日期"
          },
          "tripId": {
            "type": "string"
          }
        },
        "required": [
          "today",
          "tripId"
        ],
        "additionalProperties": true
      }
    },
    "required": [
      "request"
    ],
    "additionalProperties": false
  }
}
