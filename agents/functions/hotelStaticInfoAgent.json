{
  "type": "function",
  "name": "hotelStaticInfoAgent",
  "description": "酒店选定后查询静态详情，供主 Agent 组装酒店表；需要酒店名称及可用的酒店 ID。 将符合该子 Agent 输入约定的完整 JSON 放入 request，必须带 today 和 tripId。",
  "parameters": {
    "type": "object",
    "properties": {
      "request": {
        "type": "object",
        "properties": {
          "today": {
            "type": "string",
            "description": "YYYY-MM-DD 当前日期"
          },
          "tripId": {
            "type": "string"
          }
        },
        "required": [
          "today",
          "tripId"
        ],
        "additionalProperties": true
      }
    },
    "required": [
      "request"
    ],
    "additionalProperties": false
  }
}
