          "type": "object",
          "properties": {
            "today": {
              "type": "string",
              "description": "YYYY-MM-DD 当前日期"
            },
            "tripId": {
              "type": "string"
            }
          },
          "required": [
            "today",
            "tripId"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "request"
      ],
      "additionalProperties": false
    }
  },
